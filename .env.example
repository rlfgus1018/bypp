DB_PATH=./data/bypp.db

# Public deployments only: one SQLite database PER BROWSER (anonymous HttpOnly cookie "bypp_sid") at
# <dir>/<session id>/bypp.db, created on that browser's first write. Data and the Google connection are then
# never shared between visitors, and DB_PATH is not served to anyone. Leave unset for local single-database use.
# NODE_ENV alone never turns this on.  Railway: BYPP_SESSION_DIR=/data/sessions
BYPP_SESSION_DIR=

# Leave LLM_PROVIDER empty to keep the LLM off (heuristic fallback).
# Supported values: "gemini" or "openrouter". A key alone never enables the LLM.
LLM_PROVIDER=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional. Defaults by provider: gemini-3.8-flash or deepseek/deepseek-v4-flash-0731.
# LLM_MODEL=gemini-3.8-flash
# LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Throughput. Set values that match the selected provider/account limits.
# LLM_RPM          requests STARTED per rolling minute; below it nothing waits. 0 = unlimited (a paid tier).
# LLM_BATCH_SIZE   messages per request (1–10). 1 = one message per request. With 5, the same per-minute
#                  quota extracts ~5x as many messages; answers are checked per message and anything doubtful
#                  is re-extracted alone. Compare on your own data first:
#                    npm run verify:pipeline -- "<file>" --llm --limit 60 --compare-batch 5
# LLM_CONCURRENCY  requests in flight at once (1–16). Start at 8; compare 12/16 only after checking failures.
# (LLM_MIN_INTERVAL_MS from earlier versions is still read when LLM_RPM is not set.)
# For OpenRouter paid credit testing, 0 disables local pacing; the provider still enforces its limits.
LLM_RPM=14
LLM_BATCH_SIZE=1
LLM_CONCURRENCY=1

# Google Calendar (M2-B) — optional. Server-only: never prefix these with NEXT_PUBLIC_.
# Create an "OAuth client ID" of type "Web application" in Google Cloud Console, enable the Google Calendar
# API, and register the redirect URI below EXACTLY (scheme, host, port and path must match character for
# character, or Google answers redirect_uri_mismatch).
GOOGLE_CLIENT_ID=0000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional: encrypt the stored Google tokens (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to store them unencrypted in the local SQLite file. Changing or losing the key means reconnecting.
GOOGLE_TOKEN_ENCRYPTION_KEY=
