DB_PATH=./data/bypp.db

# Leave LLM_PROVIDER empty to keep the LLM off (heuristic fallback).
# The only supported value is "gemini". A key alone never enables the LLM.
LLM_PROVIDER=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Minimum gap between two Gemini requests. The free tier allows roughly 15 requests/minute
# (and a per-model daily cap: 20/day for gemini-3.x-flash, far more for the -lite models).
# 0 disables pacing, e.g. on a paid tier.
LLM_MIN_INTERVAL_MS=4500

# Google Calendar (M2-B) — optional. Server-only: never prefix these with NEXT_PUBLIC_.
# Create an "OAuth client ID" of type "Web application" in Google Cloud Console, enable the Google Calendar
# API, and register the redirect URI below EXACTLY (scheme, host, port and path must match character for
# character, or Google answers redirect_uri_mismatch).
GOOGLE_CLIENT_ID=0000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional: encrypt the stored Google tokens (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to store them unencrypted in the local SQLite file. Changing or losing the key means reconnecting.
GOOGLE_TOKEN_ENCRYPTION_KEY=
